# === Google Maps API Keys ===
# Client-side (Maps JavaScript API / HTTP referrer restriction)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_client_api_key

# Server-side (Places API / Directions API / IP restriction recommended)
GOOGLE_MAPS_SERVER_API_KEY=your_server_api_key

# === Google Maps Settings ===
NEXT_PUBLIC_DEFAULT_LAT=36.2048
NEXT_PUBLIC_DEFAULT_LNG=138.2529
NEXT_PUBLIC_DEFAULT_ZOOM=5

# Places API search radius (meters)
PLACES_SEARCH_RADIUS=5000

# === App Settings ===
NEXT_PUBLIC_MAX_ROUTE_SPOTS=5
